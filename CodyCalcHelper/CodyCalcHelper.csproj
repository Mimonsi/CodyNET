<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\CodyNET.Core\CodyNET.Core.csproj" />
      <ProjectReference Include="..\CodyNET.Disassembler\CodyNET.Disassembler.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\roms\codybasic.bin" Link="roms\codybasic.bin">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
