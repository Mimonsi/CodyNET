<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CodyNET.Frontend.Controls"
        x:Class="CodyNET.Frontend.MainWindow"
        Title="Cody Computer Emulator"
        Width="1400"
        Height="900"
        MinWidth="1000"
        MinHeight="700"
        Background="#1E1E1E">
    <Window.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#2B292E" />
            <Setter Property="BorderBrush" Value="#4A474F" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.panel-header">
            <Setter Property="Background" Value="#2E2B31" />
            <Setter Property="BorderBrush" Value="#4A474F" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="18,14" />
        </Style>

        <Style Selector="TextBlock.panel-header-text">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#F5F5F7" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#99B7DE" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style Selector="TextBlock.data-label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#F2F2F3" />
        </Style>
        <Style Selector="TextBlock.data-hex">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
            <Setter Property="Foreground" Value="#48FF88" />
        </Style>
        <Style Selector="TextBlock.data-dec">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
            <Setter Property="Foreground" Value="#FFCC3E" />
        </Style>
        <Style Selector="TextBlock.code-text">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Styles>
    <DockPanel LastChildFill="True"> <!-- Header Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Load UART1.." Click="OnLoadUart1Click" />
                <MenuItem Header="_Exit" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Scale 100%" Tag="1.0" Click="OnScaleMenuClick" />
                <MenuItem Header="Scale 200%" Tag="2.0" Click="OnScaleMenuClick" />
                <MenuItem Header="Scale 300%" Tag="3.0" Click="OnScaleMenuClick" />
                <MenuItem Header="Scale 400%" Tag="4.0" Click="OnScaleMenuClick" />
                <MenuItem Header="Scale 600%" Tag="6.0" Click="OnScaleMenuClick" />
                <MenuItem Header="Scale 800%" Tag="8.0" Click="OnScaleMenuClick" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="500 _kHz" Tag="500000" Click="OnClockMenuClick" />
                <MenuItem Header="_1 MHz (Standard)" Tag="1000000" Click="OnClockMenuClick" />
                <MenuItem Header="_2 MHz" Tag="2000000" Click="OnClockMenuClick" />
                <MenuItem Header="_5 MHz" Tag="5000000" Click="OnClockMenuClick" />
                <MenuItem Header="_Unthrottled" Tag="-1" Click="OnClockMenuClick" />
            </MenuItem>
            <MenuItem Header="_Debug">
                <MenuItem x:Name="ShowDebuggerMenuItem"
                          Header="Show _Debugger"
                          IsChecked="True"
                          Click="OnToggleDebuggerClick" />
            </MenuItem>
        </Menu>
        
        <Border DockPanel.Dock="Bottom" Background="#0D82D2" Padding="12,8"> <!-- Footer Bar --> 
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <TextBlock x:Name="FooterModeText" Text="8-bit CPU Emulator" Foreground="White" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="•" Margin="14,0" Foreground="#B9E7FF" />
                <TextBlock x:Name="FooterStatusText" Grid.Column="2" Text="Status: Stopped" Foreground="White" FontWeight="SemiBold" />
                <TextBlock x:Name="FooterRightText" Grid.Column="4" Text="Line 13/37" Foreground="White" FontWeight="SemiBold" />
            </Grid>
        </Border>
        
        <Grid x:Name="WorkspaceGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" /> <!-- Left Column: Registers and Memory -->
                <ColumnDefinition Width="4" /> <!-- Divider -->
                <ColumnDefinition Width="*" MinWidth="420" /> <!-- Center Column, Screen and Console -->
                <ColumnDefinition Width="4" /> <!-- Divider -->
                <ColumnDefinition Width="300" MinWidth="220" /> <!-- Right Column: Code Panel -->
            </Grid.ColumnDefinitions>
            
            <Border x:Name="LeftSidebar" Grid.Column="0" Classes="panel">
                <TabControl Background="#2E2B31" BorderThickness="0">
                    <TabItem>
                        <TabItem.Header>
                            <Border Classes="panel-header">
                                <TextBlock Classes="panel-header-text" Text="CPU State" />
                            </Border>
                        </TabItem.Header>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20,18,20,22" Spacing="18"> <!-- Vertical Layout -->
                            <TextBlock Classes="section-title" Text="REGISTERS" />
                            <Grid ColumnDefinitions="*,90,90" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="data-label" Text="Name" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Classes="data-label" Text="Hex" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Classes="data-label" Text="Dec" />
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="data-label" Text="A" />
                                <TextBlock x:Name="RegisterAHexText" Grid.Row="1" Grid.Column="1" Classes="data-hex" Text="00" />
                                <TextBlock x:Name="RegisterADecText" Grid.Row="1" Grid.Column="2" Classes="data-dec" Text="0" />
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="data-label" Text="X" />
                                <TextBlock x:Name="RegisterXHexText" Grid.Row="2" Grid.Column="1" Classes="data-hex" Text="00" />
                                <TextBlock x:Name="RegisterXDecText" Grid.Row="2" Grid.Column="2" Classes="data-dec" Text="0" />
                                
                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="data-label" Text="Y" />
                                <TextBlock x:Name="RegisterYHexText" Grid.Row="3" Grid.Column="1" Classes="data-hex" Text="00" />
                                <TextBlock x:Name="RegisterYDecText" Grid.Row="3" Grid.Column="2" Classes="data-dec" Text="0" />
                                
                                <TextBlock Grid.Row="4" Grid.Column="0" Classes="data-label" Text="SP" />
                                <TextBlock x:Name="RegisterSPHexText" Grid.Row="4" Grid.Column="1" Classes="data-hex" Text="00" />
                                <TextBlock x:Name="RegisterSPDecText" Grid.Row="4" Grid.Column="2" Classes="data-dec" Text="0" />
                                
                                <TextBlock Grid.Row="5" Grid.Column="0" Classes="data-label" Text="PC" />
                                <TextBlock x:Name="RegisterPCHexText" Grid.Row="5" Grid.Column="1" Classes="data-hex" Text="0000" />
                                <TextBlock x:Name="RegisterPCDecText" Grid.Row="5" Grid.Column="2" Classes="data-dec" Text="0" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Classes="data-label" Text="P" />
                                <TextBlock x:Name="RegisterPHexText" Grid.Row="6" Grid.Column="1" Classes="data-hex" Text="00" />
                                <TextBlock x:Name="RegisterPDecText" Grid.Row="6" Grid.Column="2" Classes="data-dec" Text="0" />
                            </Grid>

                            <TextBlock Classes="section-title" Text="FLAGS" />
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="data-label" Text="Carry" />
                                <TextBlock x:Name="FlagCarryText" Grid.Row="0" Grid.Column="1" Classes="data-dec" Text="0" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="data-label" Text="Zero" />
                                <TextBlock x:Name="FlagZeroText" Grid.Row="1" Grid.Column="1" Classes="data-dec" Text="0" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="data-label" Text="Irq Disable" />
                                <TextBlock x:Name="FlagInterruptDisableText" Grid.Row="2" Grid.Column="1" Classes="data-dec" Text="0" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="data-label" Text="Decimal" />
                                <TextBlock x:Name="FlagDecimalText" Grid.Row="3" Grid.Column="1" Classes="data-dec" Text="0" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Classes="data-label" Text="Break" />
                                <TextBlock x:Name="FlagBreakText" Grid.Row="4" Grid.Column="1" Classes="data-dec" Text="0" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Classes="data-label" Text="Overflow" />
                                <TextBlock x:Name="FlagOverflowText" Grid.Row="5" Grid.Column="1" Classes="data-dec" Text="0" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Classes="data-label" Text="Negative" />
                                <TextBlock x:Name="FlagNegativeText" Grid.Row="6" Grid.Column="1" Classes="data-dec" Text="0" />
                            </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <Border Classes="panel-header">
                                <TextBlock Classes="panel-header-text" Text="Memory" />
                            </Border>
                        </TabItem.Header>
                        <TextBlock>Moin</TextBlock>
                    </TabItem>
                </TabControl>
            </Border>
            
            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Background="#49454E" ResizeDirection="Columns"></GridSplitter>
            
            <Grid x:Name="MainColumn" Grid.Column="2" Classes="panel" RowDefinitions="*,4,250"> <!-- Center Column, Screen and fixed height Lower panel -->
                <Border Grid.Row="0" Background="#232123" Padding="16"> <!-- Screen -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <controls:ScreenControl x:Name="Screen"
                                                Focusable="True"
                                                ScaleFactor="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                    </ScrollViewer>
                </Border>
                
                <GridSplitter Grid.Row="1" Background="#49454E" ResizeDirection="Rows" /> <!-- Screen-Lower Divider -->
                
                
                <Border x:Name="LowerPanel" Grid.Row="2" Background="#201F22"> <!-- Lower Panel, Below Screen, not decided yet -->
                    <Border Classes="panel-header">
                        <TextBlock Classes="panel-header-text" Text="Lower Panel" />
                    </Border>
                </Border>
            </Grid>
            
            <GridSplitter x:Name="RightSplitter" Grid.Column="3" Background="#49454E" ResizeDirection="Columns"></GridSplitter>
            
            <Border x:Name="CodePanel" Grid.Column="4"> <!-- Right Colum: Code Panel -->
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="panel-header">
                        <TextBlock Classes="panel-header-text" Text="Code Panel" />
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18,16,18,24" Spacing="6"> <!-- TODO: Find out how to embed the whole code with formatting (and add breakpoints)-->
                            <DockPanel><TextBlock Width="42" Classes="code-text" Text="1" Foreground="#8191B0" /><TextBlock Classes="code-text" Text="PROGRAM START" Foreground="#00FF8E" /></DockPanel>
                            <DockPanel><TextBlock Width="42" Classes="code-text" Text="2" Foreground="#8191B0" /><TextBlock Classes="code-text" Text="PROGRAM END" Foreground="#00FF8E" /></DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
